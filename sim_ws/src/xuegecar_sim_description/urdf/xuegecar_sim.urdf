<?xml version="1.0"?>
<robot name="xuegecar_sim">

  <!-- ================================================================
       3.2-c + 3.3：补上万向轮（caster），并挂上 Gazebo 差速插件
       最终结构：
         base_footprint
            └─[fixed]─ base_link
                 ├─[continuous]─ left_wheel_link
                 ├─[continuous]─ right_wheel_link
                 └─[continuous]─ caster_link
       ================================================================ -->

  <material name="blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>
  <material name="gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <!-- 虚拟根节点：车体在地面的投影点 -->
  <link name="base_footprint"/>

  <!-- 车体本体 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.15 0.08"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.15 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.002408" ixy="0" ixz="0"
               iyy="0.003867" iyz="0"
               izz="0.005208"/>
    </inertial>
  </link>

  <!-- 左轮 -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00002974" ixy="0" ixz="0"
               iyy="0.00005281" iyz="0"
               izz="0.00002974"/>
    </inertial>
  </link>

  <!-- 右轮 -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00002974" ixy="0" ixz="0"
               iyy="0.00005281" iyz="0"
               izz="0.00002974"/>
    </inertial>
  </link>

  <!-- 万向轮（caster）：三点支撑的第三点。
       没有它，车只有两个轮子着地，前后会翘翻、在 Gazebo 里会「点头」甚至翻倒。 -->
  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <!-- 实心球：I = 2mr²/5 -->
      <inertia ixx="0.0000045" ixy="0" ixz="0"
               iyy="0.0000045" iyz="0"
               izz="0.0000045"/>
    </inertial>
  </link>

  <!-- ================= 关节 ================= -->

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.0325" rpy="0 0 0"/>
  </joint>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.085 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="20"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.085 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="20"/>
  </joint>

  <!-- caster 放在车尾：球心离地 = 球半径 0.015，
       相对 base_link（高度 0.0325）就是 0.015 - 0.0325 = -0.0175 -->
  <joint name="caster_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.07 0 -0.0175" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1" velocity="20"/>
  </joint>

  <!-- ================================================================
       Gazebo 插件区
       ================================================================ -->

  <!-- 万向轮若摩擦太大，会「拖住」小车。这里把它设成近似无摩擦的滑动点 -->
  <gazebo reference="caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo>
    <!-- ① 差速驱动插件：仿真世界里的「底盘」
         收 /cmd_vel → 算差速运动学 → 驱动左右轮 → 发 /odom 与 odom→base_footprint -->
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
      </ros>

      <update_rate>50</update_rate>

      <!-- 轮子 -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <!-- 运动学（必须与 URDF 里的几何一致，否则 odom 会算错） -->
      <wheel_separation>0.17</wheel_separation>
      <wheel_diameter>0.065</wheel_diameter>

      <!-- 限幅 -->
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>

      <!-- 输出：odom 话题 + odom→base_footprint 的 TF；
           轮子 TF 交给 joint_state_publisher 插件 + robot_state_publisher 发，
           保证 TF 树完全来自 URDF（职责更清晰） -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>

    <!-- ② 关节状态插件：把 Gazebo 里轮子的真实转角发到 /joint_states，
           这样 robot_state_publisher 才能算出轮子的 TF -->
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>caster_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
