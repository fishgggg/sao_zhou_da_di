<?xml version="1.0"?>
<robot name="xuegecar_sim" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================
       阶段 5：传感器接入

       新增：
         - laser_frame（雷达安装位）+ 2D 雷达插件  → /scan
         - imu_link  （IMU 安装位）  + IMU 插件     → /imu
       两者的 TF 都由 robot_state_publisher 从 URDF 发布（fixed joint）。
       ================================================================ -->

  <!-- ========== ① 几何 / 质量参数 ========== -->
  <xacro:property name="wheel_radius"      value="0.0325"/>
  <xacro:property name="wheel_width"       value="0.02"/>
  <xacro:property name="wheel_separation"  value="0.17"/>
  <xacro:property name="wheel_mass"        value="0.1"/>

  <xacro:property name="body_length"       value="0.20"/>
  <xacro:property name="body_width"        value="0.15"/>
  <xacro:property name="body_height"       value="0.08"/>
  <xacro:property name="body_mass"         value="1.0"/>

  <xacro:property name="caster_radius"     value="0.015"/>
  <xacro:property name="caster_mass"       value="0.05"/>
  <xacro:property name="caster_offset_x"   value="-0.07"/>

  <!-- ========== ② 传感器参数 ========== -->
  <xacro:property name="sensor_mass"        value="0.01"/>

  <!-- 雷达装在车体顶面：base_link 在轮心高度，车体中心 +0.04，顶面再 +0.04 -->
  <xacro:property name="laser_x"            value="0.0"/>
  <xacro:property name="laser_y"            value="0.0"/>
  <!-- 关键：必须再抬高一点（standoff），让雷达脱离车体顶面。
       否则水平射线会贴着车壳扫，测出一堆 0.075~0.12 m 的虚假近距点
       （正好等于车体半宽 / 半长）——实测踩过这个坑。 -->
  <xacro:property name="laser_standoff"     value="0.02"/>
  <xacro:property name="laser_z"            value="${body_z + body_height/2 + laser_standoff}"/>

  <xacro:property name="laser_samples"      value="360"/>
  <xacro:property name="laser_min_angle"    value="-3.14159265"/>
  <xacro:property name="laser_max_angle"    value="3.14159265"/>
  <xacro:property name="laser_min_range"    value="0.05"/>
  <xacro:property name="laser_max_range"    value="12.0"/>
  <xacro:property name="laser_update_rate"  value="10"/>

  <!-- IMU 装在车体中心 -->
  <xacro:property name="imu_x"              value="0.0"/>
  <xacro:property name="imu_y"              value="0.0"/>
  <xacro:property name="imu_z"              value="${body_z}"/>
  <xacro:property name="imu_update_rate"    value="100"/>

  <!-- ========== ③ 派生量 ========== -->
  <xacro:property name="half_sep"        value="${wheel_separation / 2}"/>
  <xacro:property name="wheel_diameter"  value="${wheel_radius * 2}"/>
  <xacro:property name="body_z"          value="${body_height / 2}"/>
  <xacro:property name="caster_z"        value="${caster_radius - wheel_radius}"/>

  <xacro:property name="body_ixx"
      value="${body_mass * (body_width*body_width + body_height*body_height) / 12}"/>
  <xacro:property name="body_iyy"
      value="${body_mass * (body_length*body_length + body_height*body_height) / 12}"/>
  <xacro:property name="body_izz"
      value="${body_mass * (body_length*body_length + body_width*body_width) / 12}"/>

  <xacro:property name="wheel_ixx"
      value="${wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width) / 12}"/>
  <xacro:property name="wheel_iyy"
      value="${wheel_mass * wheel_radius * wheel_radius / 2}"/>

  <xacro:property name="caster_i"
      value="${2 * caster_mass * caster_radius * caster_radius / 5}"/>

  <!-- 传感器是很小的实心块，惯量取近似值即可 -->
  <xacro:property name="sensor_i" value="${sensor_mass * 0.0001 / 6}"/>

  <!-- ========== ④ 材质 ========== -->
  <material name="blue"><color rgba="0.2 0.4 0.8 1.0"/></material>
  <material name="black"><color rgba="0.15 0.15 0.15 1.0"/></material>
  <material name="gray"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="red"><color rgba="0.8 0.2 0.2 1.0"/></material>
  <material name="green"><color rgba="0.2 0.8 0.3 1.0"/></material>

  <!-- ========== ⑤ 虚拟根 ========== -->
  <link name="base_footprint"/>

  <!-- ========== ⑥ 车体 ========== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <mass value="${body_mass}"/>
      <inertia ixx="${body_ixx}" ixy="0" ixz="0"
               iyy="${body_iyy}" iyz="0"
               izz="${body_izz}"/>
    </inertial>
  </link>

  <!-- ========== ⑦ 轮子宏 ========== -->
  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_ixx}" ixy="0" ixz="0"
                 iyy="${wheel_iyy}" iyz="0"
                 izz="${wheel_ixx}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${reflect * half_sep} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="10" velocity="20"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left"  reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

  <!-- ========== ⑧ 万向轮 ========== -->
  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${caster_mass}"/>
      <inertia ixx="${caster_i}" ixy="0" ixz="0"
               iyy="${caster_i}" iyz="0"
               izz="${caster_i}"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_offset_x} 0 ${caster_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1" velocity="20"/>
  </joint>

  <!-- ========== ⑨ 雷达安装位（laser_frame）========== -->
  <!-- 只是个「坐标标记」：告诉系统雷达装在车的什么地方。
       传感器数据的坐标变换靠它，物理仿真里它本身不参与碰撞。 -->
  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.03"/></geometry>
      <material name="red"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${sensor_mass}"/>
      <inertia ixx="${sensor_i}" ixy="0" ixz="0"
               iyy="${sensor_i}" iyz="0"
               izz="${sensor_i}"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="${laser_x} ${laser_y} ${laser_z}" rpy="0 0 0"/>
  </joint>

  <!-- ========== ⑩ IMU 安装位（imu_link）========== -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.01"/></geometry>
      <material name="green"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${sensor_mass}"/>
      <inertia ixx="${sensor_i}" ixy="0" ixz="0"
               iyy="${sensor_i}" iyz="0"
               izz="${sensor_i}"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/>
  </joint>

  <!-- ========== ⑪ 底盘关节 ========== -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================
       Gazebo 插件区
       ================================================================ -->

  <!-- caster 摩擦置零，避免拖住小车 -->
  <gazebo reference="caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- ⑫ 2D 雷达传感器 -->
  <!-- 注意结构：<gazebo reference="挂着它的 link"> 里放 <sensor>，
       sensor 里再放「加载数据的 ROS 插件」 -->
  <gazebo reference="laser_frame">
    <sensor name="laser" type="ray">
      <ray>
        <scan>
          <horizontal>
            <samples>${laser_samples}</samples>
            <resolution>1</resolution>
            <min_angle>${laser_min_angle}</min_angle>
            <max_angle>${laser_max_angle}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>${laser_min_range}</min>
          <max>${laser_max_range}</max>
        </range>
      </ray>
      <always_on>true</always_on>
      <update_rate>${laser_update_rate}</update_rate>
      <visualize>true</visualize>
      <plugin name="laserscan" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ⑬ IMU 传感器 -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>${imu_update_rate}</update_rate>
      <visualize>false</visualize>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ⑭ 差速驱动 -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <!-- 阶段 8：底盘只服从 /cmd_vel_motor。
             所有速度来源（teleop / Nav2 / 状态机）都必须先经任务状态机，
             由状态机决定放行、限幅、还是清零。
             没有这一行，状态机就永远无法真正「切断」动力。 -->
        <remapping>cmd_vel:=cmd_vel_motor</remapping>
      </ros>
      <update_rate>50</update_rate>

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${wheel_diameter}</wheel_diameter>

      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>

    <!-- ⑮ 关节状态：把轮子真实转角发到 /joint_states，供 robot_state_publisher 算出轮子 TF -->
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>caster_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
